if(moduleExists('pages')) {
    foreach (LocaleManager::getLocalesByFilter(['showAll' => true]) as $oLocale) {
        if (!($oPageCookiePolicy = PageManager::getPageByName('cookiepolicy', $oLocale->languageId))) {
            $aLogs[$sModuleName]['errors'][] = 'Missing page `Cookie Policy` for language `' . strtoupper($oLocale->getLanguage()->code) . '`';
            if ($bInstall) {
                $oPageCookiePolicy             = new Page();
                $oPageCookiePolicy->languageId = $oLocale->languageId;
                $oPageCookiePolicy->name       = 'cookiepolicy';
                $oPageCookiePolicy->title      = 'Cookie Policy';
                $oPageCookiePolicy->content    = '<p>There is currently no cookie policy available for this website.</p><br><p>However, if you\'d like to reset your cookie preferences <a href="?reset-cookies=1">you can click this link to reset your cookie preferences for this website.</a></p>';
                $oPageCookiePolicy->shortTitle = 'Cookie Policy';
                $oPageCookiePolicy->setInFooter(true);
                $oPageCookiePolicy->setControllerPath('/modules/pages/site/controllers/page.cont.php');
                $oPageCookiePolicy->setInMenu(0);
                $oPageCookiePolicy->setIndexable(0);
                $oPageCookiePolicy->setOnlineChangeable(0);
                $oPageCookiePolicy->setDeletable(0);
                $oPageCookiePolicy->setMayHaveSub(0);
                $oPageCookiePolicy->setLockUrlPath(1);
                $oPageCookiePolicy->setLockParent(1);
                $oPageCookiePolicy->setHideImageManagement(1);
                $oPageCookiePolicy->setHideFileManagement(1);
                $oPageCookiePolicy->setHideLinkManagement(1);
                $oPageCookiePolicy->setHideVideoLinkManagement(1);
                if ($oPageCookiePolicy->isValid()) {
                    PageManager::savePage($oPageCookiePolicy);
                } else {
                    _d($oPageCookiePolicy->getInvalidProps());
                    die('Can\'t create page `cookiepolicy for locale`' . strtoupper($oLocale->getLanguage()->code));
                }
            }
        }
    }
}

if(!Settings::exists('cc_enabled')){
    $aLogs[$sModuleName]['errors'][] = 'Missing setting `cc_enabled`';
    if($bInstall){
        $oSetting = new Setting();
        $oSetting->name = "cc_enabled";
        $oSetting->value = 1;
        SettingManager::saveSetting($oSetting);
    }
}

